\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces {\color {blue}\uwave {$\texttt  {cxt}\xspace  $ introduces the notation of }}\textit  {{\color {blue}\uwave {next-coalescence prediction}}} {\color {blue}\uwave {(Left). }}\texttt  {cxt}\xspace  {} {\color {blue}\uwave {is a language model that conditions on a chosen ``pivot'' haplotype pair and predicts the pair's time to the most recent common ancestor (TMRCA) for each window. }}\texttt  {cxt}\xspace  {\color {blue}\uwave {ingests mutational tensors constructed using the pivot pair and site--frequency--spectrum (SFS) values computed in windows across a focal region. The model works autoregressively: after each window is predicted, that estimate is appended to the context and supplied to the next step, yielding a step-wise reconstruction of the entire pairwise coalescent history. Because every haplotype pair can be processed in parallel, the approach scales efficiently with available GPU memory. In the right panel all $\binom  {50}{2}$ pairwise coalescence curves for a sample of 50 haplotypes were inferred simultaneously in under five minutes on a single NVIDIA~A100 GPU. True TMRCAs are plotted in black, individual replicate predictions in light blue, and the prediction mean in dark blue.}}\relax }}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:schematic}{{1}{4}{\DIFaddFL {$\cxtkit $ introduces the notation of }\textit {\DIFaddFL {next-coalescence prediction}} \DIFaddFL {(Left). }\cxtkit {} \DIFaddFL {is a language model that conditions on a chosen ``pivot'' haplotype pair and predicts the pair's time to the most recent common ancestor (TMRCA) for each window. }\cxtkit \DIFaddFL {ingests mutational tensors constructed using the pivot pair and site--frequency--spectrum (SFS) values computed in windows across a focal region. The model works autoregressively: after each window is predicted, that estimate is appended to the context and supplied to the next step, yielding a step-wise reconstruction of the entire pairwise coalescent history. Because every haplotype pair can be processed in parallel, the approach scales efficiently with available GPU memory. In the right panel all $\binom {50}{2}$ pairwise coalescence curves for a sample of 50 haplotypes were inferred simultaneously in under five minutes on a single NVIDIA~A100 GPU. True TMRCAs are plotted in black, individual replicate predictions in light blue, and the prediction mean in dark blue.}\relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces True versus predicted coalescence times for three inference approaches across two demographic scenarios: a constant population size and a fluctuating {\color {red}\sout@orig {“}}{\color {blue}\uwave {``}}sawtooth{\color {red}\sout@orig {’’ }}{\color {blue}\uwave {'' }}demography. \textbf  {{\color {red}\sout@orig {Top row}}}{\color {blue}\uwave {Top row}}: \texttt  {cxt-narrow} evaluated on the constant-size scenario (left) and on the sawtooth scenario (middle), followed by \texttt  {cxt-broad} evaluated on the sawtooth scenario (right). The broad model\textemdash trained on a wider range of demographic histories\textemdash achieves substantially improved accuracy. \textbf  {{\color {red}\sout@orig {Bottom row}}}{\color {blue}\uwave {Bottom row}}: \texttt  {Singer+Polegon} evaluated on the constant-size (left) and sawtooth (middle) scenarios. The two rightmost panels show \texttt  {SMC++}\xspace  {} applied to the constant-size and sawtooth scenarios, respectively. Although \texttt  {SMC++}\xspace  {} is primarily designed for population-size inference, we include its decoding-based coalescence-time estimates for completeness. Mean squared errors (MSE) for each panel are reported within the plots.\relax }}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:benchmark}{{2}{5}{True versus predicted coalescence times for three inference approaches across two demographic scenarios: a constant population size and a fluctuating \DIFdelbeginFL \DIFdelFL {“}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {``}\DIFaddendFL sawtooth\DIFdelbeginFL \DIFdelFL {’’ }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {'' }\DIFaddendFL demography. \DIFdelbeginFL \textbf {\DIFdelFL {Top row}}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {Top row}\DIFaddendFL : \texttt {cxt-narrow} evaluated on the constant-size scenario (left) and on the sawtooth scenario (middle), followed by \texttt {cxt-broad} evaluated on the sawtooth scenario (right). The broad model\textemdash trained on a wider range of demographic histories\textemdash achieves substantially improved accuracy. \DIFdelbeginFL \textbf {\DIFdelFL {Bottom row}}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {Bottom row}\DIFaddendFL : \texttt {Singer+Polegon} evaluated on the constant-size (left) and sawtooth (middle) scenarios. The two rightmost panels show \smcpp {} applied to the constant-size and sawtooth scenarios, respectively. Although \smcpp {} is primarily designed for population-size inference, we include its decoding-based coalescence-time estimates for completeness. Mean squared errors (MSE) for each panel are reported within the plots.\relax }{figure.caption.2}{}}
\citation{gower2023expanding}
\newlabel{sec:calibration}{{}{6}{}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces {\color {blue}\uwave {Out-of-sample evaluation of the broad model on }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {v0.3. Each panel shows inferred marginal coalescence distributions (dashed) against true distributions (shaded). We simulated data from the novel species / demographic histories added in }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {v0.3, aggregating pairwise inferences into kernel density plots. All results are from simulations previously unseen during training (Top Rows: }}\texttt  {cxt}\xspace  {\color {blue}\uwave {; Middle Rows: }}\texttt  {{\color {blue}\uwave {Singer+Polegon}}}{\color {blue}\uwave {; Bottom Rows: }}\texttt  {SMC++}\xspace  {\color {blue}\uwave {).}}\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:stdpopsim_v3}{{3}{7}{\DIFaddFL {Out-of-sample evaluation of the broad model on }\stdpopsim \DIFaddFL {v0.3. Each panel shows inferred marginal coalescence distributions (dashed) against true distributions (shaded). We simulated data from the novel species / demographic histories added in }\stdpopsim \DIFaddFL {v0.3, aggregating pairwise inferences into kernel density plots. All results are from simulations previously unseen during training (Top Rows: }\cxtkit \DIFaddFL {; Middle Rows: }\texttt {\DIFaddFL {Singer+Polegon}}\DIFaddFL {; Bottom Rows: }\smcpp \DIFaddFL {).}\relax }{figure.caption.3}{}}
