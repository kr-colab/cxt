\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\color {blue}\uwave {Inverse-instantaneous coalescence rate calculation for the piecewise-constant demography of }}\textit  {{\color {blue}\uwave {H. sapiens}}} {\color {blue}\uwave {(left), }}\textit  {{\color {blue}\uwave {A. thaliana}}} {\color {blue}\uwave {(middle) and }}\textit  {{\color {blue}\uwave {B. taurus}}} {\color {blue}\uwave {(right). The inference of pairwise-coalescence events leads to the implicit inference of demography estimates through the marginal coalescence distribution assuming coalescence occurs as a Poisson process (see methods). For each scenario 10 Mb and 25 diploid samples have been used to achieve resolution throughout the specified time-windows.}}\relax }}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:demography}{{4}{8}{\DIFaddFL {Inverse-instantaneous coalescence rate calculation for the piecewise-constant demography of }\textit {\DIFaddFL {H. sapiens}} \DIFaddFL {(left), }\textit {\DIFaddFL {A. thaliana}} \DIFaddFL {(middle) and }\textit {\DIFaddFL {B. taurus}} \DIFaddFL {(right). The inference of pairwise-coalescence events leads to the implicit inference of demography estimates through the marginal coalescence distribution assuming coalescence occurs as a Poisson process (see methods). For each scenario 10 Mb and 25 diploid samples have been used to achieve resolution throughout the specified time-windows.}\relax }{figure.caption.4}{}}
\citation{grau2020evolution}
\citation{grau2020evolution}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\color {blue}\uwave {Inference of coalescent times from 25 focal pairs of British individuals of the 1000 Genomes project. The top panel shows chromosome-wide TMRCA landscapes for chromosomes~2 (left) and~6 (right). The bottom panel zooms into the LCT region on chromosome~2 (left) and the HLA region on chromosome~6 (right). Each pivot pair has been inferred 15 times to get a reliable mean, median and variance estimates. Additionally, light blue lines show the respective inferences of the 25 pairs.}}\relax }}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:human1kg}{{5}{9}{\DIFaddFL {Inference of coalescent times from 25 focal pairs of British individuals of the 1000 Genomes project. The top panel shows chromosome-wide TMRCA landscapes for chromosomes~2 (left) and~6 (right). The bottom panel zooms into the LCT region on chromosome~2 (left) and the HLA region on chromosome~6 (right). Each pivot pair has been inferred 15 times to get a reliable mean, median and variance estimates. Additionally, light blue lines show the respective inferences of the 25 pairs.}\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces {\color {blue}\uwave {Coalescent-time structure across the }}\emph  {{\color {blue}\uwave {In(2L)a}}} {\color {blue}\uwave {inversion on chr2L. Top: mean TMRCA summaries for an outside background region (10--20~Mb), the full inversion core interval, and two interior 0.5~Mb windows positioned 1~Mb inside each breakpoint (mean $\pm $ s.e.m.\ across replicate trajectories; ``All'' aggregates populations). Bottom: genome-wide mean TMRCA curves shown per population and pooled (``All''), with vertical guides marking inversion boundaries, breakpoint-adjacent windows, and the interior sampling windows used for summary statistics.}}\relax }}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:inversion}{{6}{10}{\DIFaddFL {Coalescent-time structure across the }\emph {\DIFaddFL {In(2L)a}} \DIFaddFL {inversion on chr2L. Top: mean TMRCA summaries for an outside background region (10--20~Mb), the full inversion core interval, and two interior 0.5~Mb windows positioned 1~Mb inside each breakpoint (mean $\pm $ s.e.m.\ across replicate trajectories; ``All'' aggregates populations). Bottom: genome-wide mean TMRCA curves shown per population and pooled (``All''), with vertical guides marking inversion boundaries, breakpoint-adjacent windows, and the interior sampling windows used for summary statistics.}\relax }{figure.caption.6}{}}
