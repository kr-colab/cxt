\@writefile{lof}{\contentsline {figure}{\numberline {S12}{\ignorespaces {\color {blue}\uwave {Inverse-instantaneous coalescence rate calculation of a two population out-of-Africa demography for }}\textit  {{\color {blue}\uwave {H. sapiens}}} {\color {blue}\uwave {using (}}\textbf  {{\color {blue}\uwave {left}}}{\color {blue}\uwave {) a mixture of African and European samples for cross-coalescence rate estimation, (}}\textbf  {{\color {blue}\uwave {middle}}}{\color {blue}\uwave {) only African samples or (}}\textbf  {{\color {blue}\uwave {right}}}{\color {blue}\uwave {) only European samples. The inference of pairwise-coalescence events leads to the implicit inference of demography estimates through the marginal coalescence distribution assuming coalescence occurs as a Poisson process (see methods). For each scenario 10 Mb and 25 diploid samples have been used to achieve resolution throughout the specified time-windows. }}\relax }}{21}{figure.caption.18}\protected@file@percent }
\newlabel{fig:iicr_cross}{{S12}{21}{\DIFaddFL {Inverse-instantaneous coalescence rate calculation of a two population out-of-Africa demography for }\textit {\DIFaddFL {H. sapiens}} \DIFaddFL {using (}\textbf {\DIFaddFL {left}}\DIFaddFL {) a mixture of African and European samples for cross-coalescence rate estimation, (}\textbf {\DIFaddFL {middle}}\DIFaddFL {) only African samples or (}\textbf {\DIFaddFL {right}}\DIFaddFL {) only European samples. The inference of pairwise-coalescence events leads to the implicit inference of demography estimates through the marginal coalescence distribution assuming coalescence occurs as a Poisson process (see methods). For each scenario 10 Mb and 25 diploid samples have been used to achieve resolution throughout the specified time-windows. }\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S13}{\ignorespaces {\color {blue}\uwave {Inference of coalescent-time landscapes in the Ag1000G }}\emph  {{\color {blue}\uwave {A.~gambiae}}} {\color {blue}\uwave {dataset across five African populations using }}\texttt  {cxt}\xspace  {\color {blue}\uwave {. In the upper panel, we analyze the }}\emph  {{\color {blue}\uwave {Rdl}}} {\color {blue}\uwave {region for Burkina Faso, Mali, Cameroon, Ghana, and Uganda. For these countries, we infer coalescent times for 25 focal haplotype pairs per population; for Ghana, we analyze five diploid individuals. Light-blue curves indicate per-pair coalescent-time trajectories inferred by }}\texttt  {cxt}\xspace  {\color {blue}\uwave {, with the mean trend shown in darker blue. The lower panel shows genome-wide coalescent-time landscapes across the entirety of chromosome~2L for Uganda samples. Missing data density is shown beneath both the regional and genome-wide panels as a genome browser track. }}\relax }}{22}{figure.caption.19}\protected@file@percent }
\newlabel{fig:anopheles_main}{{S13}{22}{\DIFaddFL {Inference of coalescent-time landscapes in the Ag1000G }\emph {\DIFaddFL {A.~gambiae}} \DIFaddFL {dataset across five African populations using }\cxtkit \DIFaddFL {. In the upper panel, we analyze the }\emph {\DIFaddFL {Rdl}} \DIFaddFL {region for Burkina Faso, Mali, Cameroon, Ghana, and Uganda. For these countries, we infer coalescent times for 25 focal haplotype pairs per population; for Ghana, we analyze five diploid individuals. Light-blue curves indicate per-pair coalescent-time trajectories inferred by }\cxtkit \DIFaddFL {, with the mean trend shown in darker blue. The lower panel shows genome-wide coalescent-time landscapes across the entirety of chromosome~2L for Uganda samples. Missing data density is shown beneath both the regional and genome-wide panels as a genome browser track. }\relax }{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S14}{\ignorespaces {\color {blue}\uwave {Inference of coalescent-time landscapes in the Ag1000G }}\emph  {{\color {blue}\uwave {A.~gambiae}}} {\color {blue}\uwave {dataset across five African populations (Upper panel). For Burkina Faso, Mali, Cameroon, and Uganda, we analyze 25 focal pairs per population; for Ghana, we analyzed only five diploid individuals. Panels show the }}\emph  {{\color {blue}\uwave {Rdl}}} {\color {blue}\uwave {region (highlighted in red), with estimates from }}\texttt  {cxt}\xspace  {\color {blue}\uwave {(left), }}\texttt  {{\color {blue}\uwave {Singer+Polegon}}} {\color {blue}\uwave {(middle), and }}\texttt  {SMC++}\xspace  {\color {blue}\uwave {\ (right). Light-blue curves indicate per-pair inferences. The lower two panels show coalescent-time landscapes for the entirety of chr 2L for Uganda samples. Missing data density is shown beneath both the upper and lower panels as a genome browser track. }}\relax }}{23}{figure.caption.20}\protected@file@percent }
\newlabel{fig:anopheles}{{S14}{23}{\DIFaddFL {Inference of coalescent-time landscapes in the Ag1000G }\emph {\DIFaddFL {A.~gambiae}} \DIFaddFL {dataset across five African populations (Upper panel). For Burkina Faso, Mali, Cameroon, and Uganda, we analyze 25 focal pairs per population; for Ghana, we analyzed only five diploid individuals. Panels show the }\emph {\DIFaddFL {Rdl}} \DIFaddFL {region (highlighted in red), with estimates from }\cxtkit \DIFaddFL {(left), }\texttt {\DIFaddFL {Singer+Polegon}} \DIFaddFL {(middle), and }\smcpp \DIFaddFL {\ (right). Light-blue curves indicate per-pair inferences. The lower two panels show coalescent-time landscapes for the entirety of chr 2L for Uganda samples. Missing data density is shown beneath both the upper and lower panels as a genome browser track. }\relax }{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S15}{\ignorespaces Comparison of the average TMRCA (with generation time of 28 years) for adjacent 100 Kb windows and the average number of recombination breakpoints for 25 pivot pairs using the inferences from the 1000 Genomes Project for chromosome 2 (\textbf  {left}) and chromosome 6 (\textbf  {right}).\relax }}{24}{figure.caption.21}\protected@file@percent }
\newlabel{fig:tmrca_recom}{{S15}{24}{Comparison of the average TMRCA (with generation time of 28 years) for adjacent 100 Kb windows and the average number of recombination breakpoints for 25 pivot pairs using the inferences from the 1000 Genomes Project for chromosome 2 (\textbf {left}) and chromosome 6 (\textbf {right}).\relax }{figure.caption.21}{}}
