\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces {\color {blue}\uwave {Processing of a genotype matrix, as detailed in Algorithm~\ref  {alg:vectorized}. This figure provides a schematic overview. Starting at (}}\textbf  {{\color {blue}\uwave {A}}}{\color {blue}\uwave {), we compute absolute variant frequencies across 50 samples (a fixed hyperparameter) (1). A genomic region is divided into 500 windows. We focus on a pivot pair (framed in blue), extract it, and classify sites as heterogeneous or homogeneous. Each site is scaled by its SFS class, and each window is expanded into the full sparse SFS dimensions of 50 (see input tensor, bottom right). This process repeats for three additional windows (}}\textbf  {{\color {blue}\uwave {B--D}}}{\color {blue}\uwave {), yielding a complete input tensor of shape (2, 4, 500, 50) per pair, with the SFS aggregating information across all samples.}}\relax }}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:proc}{{S1}{10}{\DIFaddFL {Processing of a genotype matrix, as detailed in Algorithm~\ref {alg:vectorized}. This figure provides a schematic overview. Starting at (}\textbf {\DIFaddFL {A}}\DIFaddFL {), we compute absolute variant frequencies across 50 samples (a fixed hyperparameter) (1). A genomic region is divided into 500 windows. We focus on a pivot pair (framed in blue), extract it, and classify sites as heterogeneous or homogeneous. Each site is scaled by its SFS class, and each window is expanded into the full sparse SFS dimensions of 50 (see input tensor, bottom right). This process repeats for three additional windows (}\textbf {\DIFaddFL {B--D}}\DIFaddFL {), yielding a complete input tensor of shape (2, 4, 500, 50) per pair, with the SFS aggregating information across all samples.}\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces  {\color {blue}\uwave {The impact }}of {\color {blue}\uwave {calibrating }}the {\color {red}\sout@orig {number }}{\color {blue}\uwave {molecular clock using observed nucleotide diversity (see section ``Calibration }}of {\color {red}\sout@orig {inferred haplotype pairs }}{\color {blue}\uwave {Molecular Clock'' in methods), using simulations from perturbations of the Zigzag model in the }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {catalog. The x-axis is a scaling of the Markov generator }}for {\color {red}\sout@orig {SMC++ }}{\color {blue}\uwave {the coalescent process, that increases the average TMRCA while keeping the shape of the site frequency spectra constant. The y-axis is a scaling of the mutation rate. The two columns correspond to uncalibrated and calibrated }}\texttt  {cxt}\xspace  {\color {blue}\uwave {predictions }}({\color {red}\sout@orig {solid; decomposed into total}}{\color {blue}\uwave {e.g. in the former}}, {\color {red}\sout@orig {preprocessing+estimate, }}{\color {blue}\uwave {the language model is predicting absolute TMRCA; }}and {\color {red}\sout@orig {decoding posterior}}{\color {blue}\uwave {in the latter relative TMRCA}}){\color {blue}\uwave {. The two rows are bias (top) and mean squared error (bottom) relative to the true TMRCA}}, {\color {blue}\uwave {calculated from 30 independent simulations per grid cell. The unperturbed demography }}({\color {red}\sout@orig {dashed blue; 1 }}{\color {blue}\uwave {which the language model sees during training) is the green point in the center of each heatmap. As the model is perturbed, the uncalibrated }}\texttt  {cxt}\xspace  {\color {blue}\uwave {predictions become substantially biased in a fashion that is nonlinear with regards }}to {\color {red}\sout@orig {3 GPUs}}{\color {blue}\uwave {the magnitude of the perturbations (left column}}){\color {blue}\uwave {; reflecting the fact that the TMRCAs}}, {\color {blue}\uwave {mutation rate, }}and {\color {blue}\uwave {recombination rate are not jointly identifiable. However, relative changes in TMRCA are predicted accurately, so that centering the TMRCA trajectories around the observed nucleotide diversity for each pivot pair }}({\color {red}\sout@orig {dashed green; two mutation-rate settings}}{\color {blue}\uwave {e.g. conditioning on the mutation rate}}) {\color {blue}\uwave {removes the bias regardless of the degree of perturbation}}. {\color {red}\sout@orig {Right panel shows }}{\color {blue}\uwave {Thus, after calibration (right column) }}the {\color {red}\sout@orig {fold difference between }}{\color {blue}\uwave {MSE for }}\texttt  {cxt}\xspace  {\color {blue}\uwave {predictions follows a gradient of mutational density. }}\relax }}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:correction-heatmap}{{S2}{11}{\DIFaddFL {The impact }\DIFaddendFL of \DIFaddbeginFL \DIFaddFL {calibrating }\DIFaddendFL the \DIFdelbeginFL \DIFdelFL {number }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {molecular clock using observed nucleotide diversity (see section ``Calibration }\DIFaddendFL of \DIFdelbeginFL \DIFdelFL {inferred haplotype pairs }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {Molecular Clock'' in methods), using simulations from perturbations of the Zigzag model in the }\stdpopsim \DIFaddFL {catalog. The x-axis is a scaling of the Markov generator }\DIFaddendFL for \DIFdelbeginFL \DIFdelFL {SMC++ }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {the coalescent process, that increases the average TMRCA while keeping the shape of the site frequency spectra constant. The y-axis is a scaling of the mutation rate. The two columns correspond to uncalibrated and calibrated }\cxtkit \DIFaddFL {predictions }\DIFaddendFL (\DIFdelbeginFL \DIFdelFL {solid; decomposed into total}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {e.g. in the former}\DIFaddendFL , \DIFdelbeginFL \DIFdelFL {preprocessing+estimate, }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {the language model is predicting absolute TMRCA; }\DIFaddendFL and \DIFdelbeginFL \DIFdelFL {decoding posterior}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {in the latter relative TMRCA}\DIFaddendFL )\DIFaddbeginFL \DIFaddFL {. The two rows are bias (top) and mean squared error (bottom) relative to the true TMRCA}\DIFaddendFL , \DIFdelbeginFL \DIFdelendFL \DIFaddbeginFL \DIFaddFL {calculated from 30 independent simulations per grid cell. The unperturbed demography }\DIFaddendFL (\DIFdelbeginFL \DIFdelFL {dashed blue; 1 }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {which the language model sees during training) is the green point in the center of each heatmap. As the model is perturbed, the uncalibrated }\cxtkit \DIFaddFL {predictions become substantially biased in a fashion that is nonlinear with regards }\DIFaddendFL to \DIFdelbeginFL \DIFdelFL {3 GPUs}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {the magnitude of the perturbations (left column}\DIFaddendFL )\DIFaddbeginFL \DIFaddFL {; reflecting the fact that the TMRCAs}\DIFaddendFL , \DIFaddbeginFL \DIFaddFL {mutation rate, }\DIFaddendFL and \DIFdelbeginFL \DIFdelendFL \DIFaddbeginFL \DIFaddFL {recombination rate are not jointly identifiable. However, relative changes in TMRCA are predicted accurately, so that centering the TMRCA trajectories around the observed nucleotide diversity for each pivot pair }\DIFaddendFL (\DIFdelbeginFL \DIFdelFL {dashed green; two mutation-rate settings}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {e.g. conditioning on the mutation rate}\DIFaddendFL ) \DIFaddbeginFL \DIFaddFL {removes the bias regardless of the degree of perturbation}\DIFaddendFL . \DIFdelbeginFL \DIFdelFL {Right panel shows }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {Thus, after calibration (right column) }\DIFaddendFL the \DIFdelbeginFL \DIFdelFL {fold difference between }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {MSE for }\cxtkit \DIFaddFL {predictions follows a gradient of mutational density. }\relax }{figure.caption.8}{}}
