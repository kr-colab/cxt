\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces {\color {blue}\uwave {Processing of a genotype matrix, as detailed in Algorithm~\ref  {alg:vectorized}. This figure provides a schematic overview. Starting at (}}\textbf  {{\color {blue}\uwave {A}}}{\color {blue}\uwave {), we compute absolute variant frequencies across 50 samples (a fixed hyperparameter) (1). A genomic region is divided into 500 windows. We focus on a pivot pair (framed in blue), extract it, and classify sites as heterogeneous or homogeneous. Each site is scaled by its SFS class, and each window is expanded into the full sparse SFS dimensions of 50 (see input tensor, bottom right). This process repeats for three additional windows (}}\textbf  {{\color {blue}\uwave {B--D}}}{\color {blue}\uwave {), yielding a complete input tensor of shape (2, 4, 500, 50) per pair, with the SFS aggregating information across all samples.}}\relax }}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:proc}{{S1}{10}{\DIFaddFL {Processing of a genotype matrix, as detailed in Algorithm~\ref {alg:vectorized}. This figure provides a schematic overview. Starting at (}\textbf {\DIFaddFL {A}}\DIFaddFL {), we compute absolute variant frequencies across 50 samples (a fixed hyperparameter) (1). A genomic region is divided into 500 windows. We focus on a pivot pair (framed in blue), extract it, and classify sites as heterogeneous or homogeneous. Each site is scaled by its SFS class, and each window is expanded into the full sparse SFS dimensions of 50 (see input tensor, bottom right). This process repeats for three additional windows (}\textbf {\DIFaddFL {B--D}}\DIFaddFL {), yielding a complete input tensor of shape (2, 4, 500, 50) per pair, with the SFS aggregating information across all samples.}\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces  {\color {blue}\uwave {The impact of calibrating the molecular clock using observed nucleotide diversity (see section ``Calibration of Molecular Clock'' in methods), using simulations from perturbations of the Zigzag model in the }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {catalog. The x-axis is a scaling of the Markov generator for the coalescent process, that increases the average TMRCA while keeping the shape of the site frequency spectra constant. The y-axis is a scaling of the mutation rate. The two columns correspond to uncalibrated and calibrated }}\texttt  {cxt}\xspace  {\color {blue}\uwave {predictions (e.g. in the former, the language model is predicting absolute TMRCA; and in the latter relative TMRCA). The two rows are bias (top) and mean squared error (bottom) relative to the true TMRCA, calculated from 30 independent simulations per grid cell. The unperturbed demography (which the language model sees during training) is the green point in the center of each heatmap. As the model is perturbed, the uncalibrated }}\texttt  {cxt}\xspace  {\color {blue}\uwave {predictions become substantially biased in a fashion that is nonlinear with regards to the magnitude of the perturbations (left column); reflecting the fact that the TMRCAs, mutation rate, and recombination rate are not jointly identifiable. However, relative changes in TMRCA are predicted accurately, so that centering the TMRCA trajectories around the observed nucleotide diversity for each pivot pair (e.g. conditioning on the mutation rate) removes the bias regardless of the degree of perturbation. Thus, after calibration (right column) the MSE for }}\texttt  {cxt}\xspace  {\color {blue}\uwave {predictions follows a gradient of mutational density. }}\relax }}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:correction-heatmap}{{S2}{11}{\DIFaddFL {The impact of calibrating the molecular clock using observed nucleotide diversity (see section ``Calibration of Molecular Clock'' in methods), using simulations from perturbations of the Zigzag model in the }\stdpopsim \DIFaddFL {catalog. The x-axis is a scaling of the Markov generator for the coalescent process, that increases the average TMRCA while keeping the shape of the site frequency spectra constant. The y-axis is a scaling of the mutation rate. The two columns correspond to uncalibrated and calibrated }\cxtkit \DIFaddFL {predictions (e.g. in the former, the language model is predicting absolute TMRCA; and in the latter relative TMRCA). The two rows are bias (top) and mean squared error (bottom) relative to the true TMRCA, calculated from 30 independent simulations per grid cell. The unperturbed demography (which the language model sees during training) is the green point in the center of each heatmap. As the model is perturbed, the uncalibrated }\cxtkit \DIFaddFL {predictions become substantially biased in a fashion that is nonlinear with regards to the magnitude of the perturbations (left column); reflecting the fact that the TMRCAs, mutation rate, and recombination rate are not jointly identifiable. However, relative changes in TMRCA are predicted accurately, so that centering the TMRCA trajectories around the observed nucleotide diversity for each pivot pair (e.g. conditioning on the mutation rate) removes the bias regardless of the degree of perturbation. Thus, after calibration (right column) the MSE for }\cxtkit \DIFaddFL {predictions follows a gradient of mutational density. }\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces {\color {blue}\uwave {The density of mutations and recombination events across perturbations of the Zigzag }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {model, for the simulations shown in Figure~\ref  {fig:correction-heatmap}.}}\relax }}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:stats-mutcoal}{{S3}{12}{\DIFaddFL {The density of mutations and recombination events across perturbations of the Zigzag }\stdpopsim \DIFaddFL {model, for the simulations shown in Figure~\ref {fig:correction-heatmap}.}\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces {\color {blue}\uwave {$\texttt  {cxt}\xspace  $s broad model fine-tuned with a low-parameter adapter to account for small sample sizes. On the left, $\texttt  {cxt}\xspace  $ is demonstrated on a constant demography, while on the right the sawtooth scenario is presented.}}\relax }}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:adapter}{{S4}{13}{\DIFaddFL {$\cxtkit $s broad model fine-tuned with a low-parameter adapter to account for small sample sizes. On the left, $\cxtkit $ is demonstrated on a constant demography, while on the right the sawtooth scenario is presented.}\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces {\color {blue}\uwave {$\texttt  {cxt}\xspace  $s broad model (left) on }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {AnoGam parameterization at window resolution 2 Kb, in the middle at 0.2 Kb and after fine-tuning on large }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {species larger than 100 k $N_e$.}}\relax }}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:anogam_w200}{{S5}{14}{\DIFaddFL {$\cxtkit $s broad model (left) on }\stdpopsim \DIFaddFL {AnoGam parameterization at window resolution 2 Kb, in the middle at 0.2 Kb and after fine-tuning on large }\stdpopsim \DIFaddFL {species larger than 100 k $N_e$.}\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Wall-clock runtime (log scale) is shown as a function of the number of inferred haplotype pairs for SMC++ (solid; decomposed into total, preprocessing+estimate, and decoding posterior), \texttt  {cxt}\xspace  (dashed blue; 1 to 3 GPUs), and \texttt  {Singer}(dashed green; two mutation-rate settings). Right panel shows the fold difference between \texttt  {Singer}and \texttt  {cxt}\xspace  with respect to recombination rate or number of GPUs. \relax }}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:time_benchmark}{{S6}{15}{Wall-clock runtime (log scale) is shown as a function of the number of inferred haplotype pairs for SMC++ (solid; decomposed into total, preprocessing+estimate, and decoding posterior), \cxtkit (dashed blue; 1 to 3 GPUs), and \singer (dashed green; two mutation-rate settings). Right panel shows the fold difference between \singer and \cxtkit with respect to recombination rate or number of GPUs. \relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Evaluation of {\color {blue}\uwave {marginal coalescence distribution inference (blue line) against the true distribution (black line), probing the model's capacity to distinguish among many scenarios based on context alone. The broad model's ability to infer a }}\texttt  {stdpopsim}\xspace  {}{\color {blue}\uwave {~v0.2 coalescence distribution is tested, which includes diverse mutation and recombination rates, as well as demographic scenarios. This distribution is obtained by aggregating pairwise inferences and visualizing the result as a kernel density for each scenario. All results shown are from new simulations, not included in the original training dataset. No genetic map was used for the inference shown here; the model itself was trained with and without genetic maps. For inferences with an underlying genetic map see Figure~\ref  {fig:margdist_map}.}}\relax }}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:margdist_nomap}{{S7}{16}{Evaluation of \DIFaddbeginFL \DIFaddFL {marginal coalescence distribution inference (blue line) against the true distribution (black line), probing the model's capacity to distinguish among many scenarios based on context alone. The broad model's ability to infer a }\stdpopsim {}\DIFaddFL {~v0.2 coalescence distribution is tested, which includes diverse mutation and recombination rates, as well as demographic scenarios. This distribution is obtained by aggregating pairwise inferences and visualizing the result as a kernel density for each scenario. All results shown are from new simulations, not included in the original training dataset. No genetic map was used for the inference shown here; the model itself was trained with and without genetic maps. For inferences with an underlying genetic map see Figure~\ref {fig:margdist_map}.}\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces {\color {blue}\uwave {Evaluation of }}inferred marginal coalescence distributions (dashed line) against the true distributions (shaded line), highlighting the model's \textbf  {capacity} - its ability to distinguish scenarios based on context alone. The model generalizes to stdpopsim v0.2 simulations {\color {red}\sout@orig {(}}\textbf  {{\color {red}\sout@orig {A1-F3}}}{\color {red}\sout@orig {) }}with varying mutation, recombination rates, and demography. Distributions are aggregated from pairwise inferences and visualized as kernel densities. All results are from new simulations, excluded from training. Unlike the {\color {red}\sout@orig {main }}{\color {blue}\uwave {preceding }}figure {\color {blue}\uwave {(Fig.~\ref  {fig:margdist_nomap})}}, this one includes simulations with a genetic map.\relax }}{17}{figure.caption.14}\protected@file@percent }
\newlabel{fig:margdist_map}{{S8}{17}{\DIFaddFL {Evaluation of }\DIFaddendFL inferred marginal coalescence distributions (dashed line) against the true distributions (shaded line), highlighting the model's \textbf {capacity} - its ability to distinguish scenarios based on context alone. The model generalizes to stdpopsim v0.2 simulations \DIFdelbeginFL \DIFdelFL {(}\textbf {\DIFdelFL {A1-F3}}\DIFdelFL {) }\DIFdelendFL with varying mutation, recombination rates, and demography. Distributions are aggregated from pairwise inferences and visualized as kernel densities. All results are from new simulations, excluded from training. Unlike the \DIFdelbeginFL \DIFdelFL {main }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {preceding }\DIFaddendFL figure \DIFaddbeginFL \DIFaddFL {(Fig.~\ref {fig:margdist_nomap})}\DIFaddendFL , this one includes simulations with a genetic map.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces  {\color {blue}\uwave {The approximate posterior distributions sampled from by }}\texttt  {cxt}\xspace  {\color {blue}\uwave {give well-calibrated estimates of uncertainty for predicted TMRCAs, across a range of scenarios. Top row: the proportion of true TMRCAs that fall within credibility intervals of a given width (e.g. a given proportion of posterior mass), as a function of position in the 1Mb prediction frame. Credibility intervals are calculated from quantiles of 100 samples from the approximate posterior for each pivot pair, and the proportion covering the true TMRCAs are calculated over 1000 independent pivot pairs (e.g. from distinct genealogical simulations). The expected proportions (for an exact posterior) are shown as dashed lines. Empirically, the approximate posteriors are asymptotically well-calibrated, although slightly over-concentrated for larger interval widths (likely due to the time discretization used by }}\texttt  {cxt}\xspace  {\color {blue}\uwave {). The decrease in coverage for the last 2Kb window is due to a tendency of the LLM to introduce large jumps in TMRCA in this window. Bottom row: the posterior variance, averaged over 1000 independent pivot pairs, as a function of position in the prediction frame and mutation rate (where $\mu $ stands for the species' mutation rate in }}\texttt  {stdpopsim}\xspace  {\color {blue}\uwave {). As mutational information accrues, the posteriors become more precise; and lose precision towards the boundaries of the prediction frame where local context has been clipped. }}\relax }}{18}{figure.caption.15}\protected@file@percent }
\newlabel{fig:posterior-calibration}{{S9}{18}{\DIFaddFL {The approximate posterior distributions sampled from by }\cxtkit \DIFaddFL {give well-calibrated estimates of uncertainty for predicted TMRCAs, across a range of scenarios. Top row: the proportion of true TMRCAs that fall within credibility intervals of a given width (e.g. a given proportion of posterior mass), as a function of position in the 1Mb prediction frame. Credibility intervals are calculated from quantiles of 100 samples from the approximate posterior for each pivot pair, and the proportion covering the true TMRCAs are calculated over 1000 independent pivot pairs (e.g. from distinct genealogical simulations). The expected proportions (for an exact posterior) are shown as dashed lines. Empirically, the approximate posteriors are asymptotically well-calibrated, although slightly over-concentrated for larger interval widths (likely due to the time discretization used by }\cxtkit \DIFaddFL {). The decrease in coverage for the last 2Kb window is due to a tendency of the LLM to introduce large jumps in TMRCA in this window. Bottom row: the posterior variance, averaged over 1000 independent pivot pairs, as a function of position in the prediction frame and mutation rate (where $\mu $ stands for the species' mutation rate in }\stdpopsim \DIFaddFL {). As mutational information accrues, the posteriors become more precise; and lose precision towards the boundaries of the prediction frame where local context has been clipped. }\relax }{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces {\color {red}\sout@orig {Out-of-sample evaluation }}{\color {blue}\uwave {Interpretation and limitations }}of {\color {red}\sout@orig {the broad model on }}{\color {red}\sout@orig {v0.3}}{\color {blue}\uwave {$\texttt  {cxt}\xspace  $ by testing various recombination to mutation ratios (top left)}}. {\color {red}\sout@orig {Each panel shows inferred marginal coalescence distributions }}{\color {blue}\uwave {The ratios have been chosen in such a way that most of stdpopsim v0.2 simulations, with the exception of some outliers, fall into this rectangle }}({\color {red}\sout@orig {dashed}}{\color {blue}\uwave {top right}}){\color {red}\sout@orig {against true distributions }}{\color {blue}\uwave {. The middle heatmaps show MSE and KLD values of $\texttt  {cxt}\xspace  $ inferences }}({\color {red}\sout@orig {shaded}}{\color {blue}\uwave {uncalibrated}}) {\color {blue}\uwave {over the entire grid, while the bottom heatmaps show mutation-rate-calibrated metrics}}. {\color {red}\sout@orig {We simulated data }}{\color {blue}\uwave {For four representative examples }}from the {\color {red}\sout@orig {novel species / demographic histories added in }}{\color {red}\sout@orig {v0.3}}{\color {blue}\uwave {corners of this grid}}, {\color {red}\sout@orig {aggregating pairwise inferences }}{\color {blue}\uwave {see Figure~\ref  {fig:bias-mutcoal}.}}\relax }}{19}{figure.caption.16}\protected@file@percent }
\newlabel{fig:interp_corr}{{S10}{19}{\DIFdelbeginFL \DIFdelFL {Out-of-sample evaluation }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {Interpretation and limitations }\DIFaddendFL of \DIFdelbeginFL \DIFdelFL {the broad model on }\DIFdelFL {v0.3}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {$\cxtkit $ by testing various recombination to mutation ratios (top left)}\DIFaddendFL . \DIFdelbeginFL \DIFdelFL {Each panel shows inferred marginal coalescence distributions }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {The ratios have been chosen in such a way that most of stdpopsim v0.2 simulations, with the exception of some outliers, fall into this rectangle }\DIFaddendFL (\DIFdelbeginFL \DIFdelFL {dashed}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {top right}\DIFaddendFL )\DIFdelbeginFL \DIFdelFL {against true distributions }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {. The middle heatmaps show MSE and KLD values of $\cxtkit $ inferences }\DIFaddendFL (\DIFdelbeginFL \DIFdelFL {shaded}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {uncalibrated}\DIFaddendFL ) \DIFaddbeginFL \DIFaddFL {over the entire grid, while the bottom heatmaps show mutation-rate-calibrated metrics}\DIFaddendFL . \DIFdelbeginFL \DIFdelFL {We simulated data }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {For four representative examples }\DIFaddendFL from the \DIFdelbeginFL \DIFdelFL {novel species / demographic histories added in }\DIFdelFL {v0.3}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {corners of this grid}\DIFaddendFL , \DIFdelbeginFL \DIFdelFL {aggregating pairwise inferences }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {see Figure~\ref {fig:bias-mutcoal}.}\relax }{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces {\color {blue}\uwave {Interpretation and limitations of $\texttt  {cxt}\xspace  $ zoomed }}into {\color {red}\sout@orig {kernel density }}{\color {blue}\uwave {four representative cases from the corners of the interpolation grid (Figure~\ref  {fig:interp_corr}), starting from top left to bottom right, with MSE and KLD indicated in the subtitles. These }}plots {\color {blue}\uwave {show the TMRCA along the sequence, while both right sides show the marginal distribution, true and inferred, respectively}}. {\color {red}\sout@orig {All results }}{\color {blue}\uwave {The left four panels (}}\textbf  {{\color {blue}\uwave {a}}}{\color {blue}\uwave {) }}are {\color {red}\sout@orig {from simulations previously unseen during training }}{\color {blue}\uwave {uncalibrated and the right four }}({\color {red}\sout@orig {Top-Row: }}{\color {red}\sout@orig {; Middle-Row: }}\texttt  {{\color {red}\sout@orig {Singer+Polegon}}}{\color {red}\sout@orig {; Bottom-Row: \texttt  {SMC++}}}\textbf  {{\color {blue}\uwave {b}}}) {\color {blue}\uwave {after calibration}}.\relax }}{20}{figure.caption.17}\protected@file@percent }
\newlabel{fig:bias-mutcoal}{{S11}{20}{\DIFaddFL {Interpretation and limitations of $\cxtkit $ zoomed }\DIFaddendFL into \DIFdelbeginFL \DIFdelFL {kernel density }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {four representative cases from the corners of the interpolation grid (Figure~\ref {fig:interp_corr}), starting from top left to bottom right, with MSE and KLD indicated in the subtitles. These }\DIFaddendFL plots \DIFaddbeginFL \DIFaddFL {show the TMRCA along the sequence, while both right sides show the marginal distribution, true and inferred, respectively}\DIFaddendFL . \DIFdelbeginFL \DIFdelFL {All results }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {The left four panels (}\textbf {\DIFaddFL {a}}\DIFaddFL {) }\DIFaddendFL are \DIFdelbeginFL \DIFdelFL {from simulations previously unseen during training }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {uncalibrated and the right four }\DIFaddendFL (\DIFdelbeginFL \DIFdelFL {Top-Row: }\DIFdelFL {; Middle-Row: }\texttt {\DIFdelFL {Singer+Polegon}}\DIFdelFL {; Bottom-Row: \smcpp }\DIFdelendFL \DIFaddbeginFL \textbf {\DIFaddFL {b}}\DIFaddendFL ) \DIFaddbeginFL \DIFaddFL {after calibration}\DIFaddendFL .\relax }{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S12}{\ignorespaces {\color {blue}\uwave {Inverse-instantaneous coalescence rate calculation of a two population out-of-Africa demography for }}\textit  {{\color {blue}\uwave {H. sapiens}}} {\color {blue}\uwave {using (}}\textbf  {{\color {blue}\uwave {left}}}{\color {blue}\uwave {) a mixture of African and European samples for cross-coalescence rate estimation, (}}\textbf  {{\color {blue}\uwave {middle}}}{\color {blue}\uwave {) only African samples or (}}\textbf  {{\color {blue}\uwave {right}}}{\color {blue}\uwave {) only European samples. The inference of pairwise-coalescence events leads to the implicit inference of demography estimates through the marginal coalescence distribution assuming coalescence occurs as a Poisson process (see methods). For each scenario 10 Mb and 25 diploid samples have been used to achieve resolution throughout the specified time-windows. }}\relax }}{21}{figure.caption.18}\protected@file@percent }
\newlabel{fig:iicr_cross}{{S12}{21}{\DIFaddFL {Inverse-instantaneous coalescence rate calculation of a two population out-of-Africa demography for }\textit {\DIFaddFL {H. sapiens}} \DIFaddFL {using (}\textbf {\DIFaddFL {left}}\DIFaddFL {) a mixture of African and European samples for cross-coalescence rate estimation, (}\textbf {\DIFaddFL {middle}}\DIFaddFL {) only African samples or (}\textbf {\DIFaddFL {right}}\DIFaddFL {) only European samples. The inference of pairwise-coalescence events leads to the implicit inference of demography estimates through the marginal coalescence distribution assuming coalescence occurs as a Poisson process (see methods). For each scenario 10 Mb and 25 diploid samples have been used to achieve resolution throughout the specified time-windows. }\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S13}{\ignorespaces Inference of {\color {blue}\uwave {coalescent-time landscapes in the Ag1000G }}\emph  {{\color {blue}\uwave {A.~gambiae}}} {\color {blue}\uwave {dataset across five African populations using }}\texttt  {cxt}\xspace  {\color {blue}\uwave {. In the upper panel, we analyze the }}\emph  {{\color {blue}\uwave {Rdl}}} {\color {blue}\uwave {region for Burkina Faso, Mali, Cameroon, Ghana, and Uganda. For these countries, we infer }}coalescent times {\color {red}\sout@orig {from }}{\color {blue}\uwave {for }}25 focal {\color {blue}\uwave {haplotype }}pairs {\color {red}\sout@orig {of British }}{\color {blue}\uwave {per population; for Ghana, we analyze five diploid }}individuals{\color {red}\sout@orig {of }}{\color {blue}\uwave {. Light-blue curves indicate per-pair coalescent-time trajectories inferred by }}\texttt  {cxt}\xspace  {\color {blue}\uwave {, with }}the {\color {red}\sout@orig {1000 Genomes project}}{\color {blue}\uwave {mean trend shown in darker blue}}. The {\color {red}\sout@orig {top-left }}{\color {blue}\uwave {lower }}panel shows {\color {red}\sout@orig {chromosome~2, and }}{\color {blue}\uwave {genome-wide coalescent-time landscapes across }}the {\color {red}\sout@orig {top-right panel shows }}{\color {blue}\uwave {entirety of }}chromosome~{\color {red}\sout@orig {6. The LCT region (bottom-left) and HLA region (bottom-right) are zoomed respectively}}{\color {blue}\uwave {2L for Uganda samples}}. {\color {red}\sout@orig {Each pivot pair has been inferred 15 times to get a reliable mean, median }}{\color {blue}\uwave {Missing data density is shown beneath both the regional }}and {\color {red}\sout@orig {variance estimates}}{\color {blue}\uwave {genome-wide panels as a genome browser track}}. {\color {red}\sout@orig {Additionally, light blue lines show the respective inferences of the 25 pairs.}}\relax }}{22}{figure.caption.19}\protected@file@percent }
\newlabel{fig:anopheles_main}{{S13}{22}{Inference of \DIFaddbeginFL \DIFaddFL {coalescent-time landscapes in the Ag1000G }\emph {\DIFaddFL {A.~gambiae}} \DIFaddFL {dataset across five African populations using }\cxtkit \DIFaddFL {. In the upper panel, we analyze the }\emph {\DIFaddFL {Rdl}} \DIFaddFL {region for Burkina Faso, Mali, Cameroon, Ghana, and Uganda. For these countries, we infer }\DIFaddendFL coalescent times \DIFdelbeginFL \DIFdelFL {from }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {for }\DIFaddendFL 25 focal \DIFaddbeginFL \DIFaddFL {haplotype }\DIFaddendFL pairs \DIFdelbeginFL \DIFdelFL {of British }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {per population; for Ghana, we analyze five diploid }\DIFaddendFL individuals\DIFdelbeginFL \DIFdelFL {of }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {. Light-blue curves indicate per-pair coalescent-time trajectories inferred by }\cxtkit \DIFaddFL {, with }\DIFaddendFL the \DIFdelbeginFL \DIFdelFL {1000 Genomes project}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {mean trend shown in darker blue}\DIFaddendFL . The \DIFdelbeginFL \DIFdelFL {top-left }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {lower }\DIFaddendFL panel shows \DIFdelbeginFL \DIFdelFL {chromosome~2, and }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {genome-wide coalescent-time landscapes across }\DIFaddendFL the \DIFdelbeginFL \DIFdelFL {top-right panel shows }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {entirety of }\DIFaddendFL chromosome~\DIFdelbeginFL \DIFdelFL {6. The LCT region (bottom-left) and HLA region (bottom-right) are zoomed respectively}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {2L for Uganda samples}\DIFaddendFL . \DIFdelbeginFL \DIFdelFL {Each pivot pair has been inferred 15 times to get a reliable mean, median }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {Missing data density is shown beneath both the regional }\DIFaddendFL and \DIFdelbeginFL \DIFdelFL {variance estimates}\DIFdelendFL \DIFaddbeginFL \DIFaddFL {genome-wide panels as a genome browser track}\DIFaddendFL . \DIFdelbeginFL \DIFdelFL {Additionally, light blue lines show the respective inferences of the 25 pairs.}\DIFdelendFL \relax }{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S14}{\ignorespaces Inference of coalescent-time landscapes in the Ag1000G \emph  {A.~gambiae} dataset across five African populations (Upper panel). For Burkina Faso, Mali, Cameroon, and Uganda, we analyze 25 focal pairs per population; for Ghana, we analysed only five diploid individuals. Panels show the \emph  {Rdl} region (highlighted in red), with estimates from \texttt  {cxt}\xspace  {\color {red}\sout@orig {\ }}(left), \texttt  {Singer+Polegon} (middle), and \texttt  {SMC++}\ (right). Light-blue curves indicate per-pair inferences. The lower two panels show coalescent-time landscapes for the entirety of chr 2L for Uganda samples. Missing data density is shown beneath both the upper and lower panels as a genome browser track. \relax }}{23}{figure.caption.20}\protected@file@percent }
\newlabel{fig:anopheles}{{S14}{23}{Inference of coalescent-time landscapes in the Ag1000G \emph {A.~gambiae} dataset across five African populations (Upper panel). For Burkina Faso, Mali, Cameroon, and Uganda, we analyze 25 focal pairs per population; for Ghana, we analysed only five diploid individuals. Panels show the \emph {Rdl} region (highlighted in red), with estimates from \cxtkit \DIFdelbeginFL \DIFdelFL {\ }\DIFdelendFL (left), \texttt {Singer+Polegon} (middle), and \smcpp \ (right). Light-blue curves indicate per-pair inferences. The lower two panels show coalescent-time landscapes for the entirety of chr 2L for Uganda samples. Missing data density is shown beneath both the upper and lower panels as a genome browser track. \relax }{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S15}{\ignorespaces Comparison of the average TMRCA (with generation time of 28 years) for adjacent 100 Kb windows and the average number of recombination breakpoints for 25 pivot pairs using the inferences from the 1000 Genomes Project for chromosome 2 (\textbf  {left}) and chromosome 6 (\textbf  {right}).\relax }}{24}{figure.caption.21}\protected@file@percent }
\newlabel{fig:tmrca_recom}{{S15}{24}{Comparison of the average TMRCA (with generation time of 28 years) for adjacent 100 Kb windows and the average number of recombination breakpoints for 25 pivot pairs using the inferences from the 1000 Genomes Project for chromosome 2 (\textbf {left}) and chromosome 6 (\textbf {right}).\relax }{figure.caption.21}{}}
